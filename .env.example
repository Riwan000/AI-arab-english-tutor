# OpenRouter (backend only — never expose in Streamlit Cloud)
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openai/gpt-4.1

# Auth (required — the API refuses to start without JWT_SECRET_KEY)
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRY_HOURS=48

# Database
DATABASE_PATH=database/english_tutor.db
RETENTION_DAYS=5

# FastAPI server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8501

# Streamlit client (set in .streamlit/secrets.toml locally, not in .env)
# BACKEND_URL=http://localhost:8000
